---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
const img = (n: string) => `/images/features/${n}.webp`;
const feats = [
  { id: 'art-checker', k: '01 / Art checker', title: 'Art checker', src: img('art-checker-report'),
    alt: 'OKtoPress art check report for a low-resolution JPG: estimate notice, 33 DPI low-resolution warning at 12 inches wide, and a 2-colour ink estimate',
    copy: 'Catch bad files before they reach your inbox. The customer gets a plain-language report they can read and share.',
    bullets: ['Effective DPI at the size they want to print', 'Ink colour count (exact for vector, estimated for PNG and JPG)', 'Low-resolution warnings before the order goes in', 'A shareable, plain-language report'], link: true },
  { id: 'leads', k: '02 / Lead generation', title: 'Lead generation', src: img('lead-gen-price-range'),
    alt: 'OKtoPress embed step 3 showing a rough estimate price range of $615 to $755 CAD for 48 tees for Example Print Co. Example data for illustration',
    copy: 'Turn art checks into people you can follow up with. The customer enters contact details to see an instant price range.',
    bullets: ['Instant price range for the customer', 'An email alert for each new lead', 'All leads in one Leads list', 'CSV export'] },
  { id: 'quotes', k: '03 / Quote generation', title: 'Quote generation', src: img('quote-editor'),
    alt: 'OKtoPress quote editor with line items, quantity and unit price, setup fees, tax and turnaround date. Example data for illustration',
    copy: 'Price jobs your way, without retyping. Set your own questions and price rules, then turn a lead into a quote in one click.',
    bullets: ['Your own questions for customers', 'Colours × quantity grid, screen fees, minimums', 'Lead to quote in one click', 'Revise and email the customer a link'] },
  { id: 'approvals', k: '04 / Approvals', title: 'Approvals', src: img('approvals-typed-name-record'),
    alt: 'Customer quote page with the name typed and the approval box ticked, above the shop’s approval record with timestamp and SHA-256 fingerprints. Example data for illustration',
    copy: 'Get clear sign-off before you burn screens. The customer approves the proof and quote by typing their name.',
    bullets: ['Approve by typing a name', 'Timestamped, tamper-evident record', 'SHA-256 fingerprint of quote and proof', 'Helps with proof disputes and chargebacks'] },
  { id: 'embed', k: '05 / On your site', title: 'On your site, in your style', src: img('embed-style-look-and-feel'),
    alt: 'OKtoPress Look & feel settings: suggest colours from your site, button, text and background colours, font and corner style, with a live preview of the checker',
    copy: 'Embed OKtoPress on your own website with one line of code. Style it to match your site.',
    bullets: ['One line of embed code', 'WordPress plugin available, Wix planned', 'Your colours, font and corners'] },
];
---
<Base title="Features: art checks, leads, quotes, approvals and deposits" description="OKtoPress features for small print shops: art checker, lead generation, quote generation, signed approvals and Stripe deposits (coming soon).">
<header class="phero w"><p class="k">Features</p><h1>Everything before the job starts.</h1>
  <p class="lede">OKtoPress owns the pre-job step for small screen print, embroidery, DTF and sign shops: art upload, quote, signed proof and deposit. It sits alongside your existing shop software.</p>
  <div class="ctas"><a class="btn lg" href={SITE.signup}>Start free</a><a class="btn ghost lg" href="/dpi-checker" data-pass-src>Try the art checker →</a></div></header>
<section class="sec tight w">
  {feats.map((c, i) => (
    <article class="feat" id={c.id}><div class="ft"><p class="k">{c.k}</p><h3>{c.title}</h3><p>{c.copy}</p><ul>{c.bullets.map((b) => <li>{b}</li>)}</ul>
      {c.link && <p style="margin-top:14px"><a href="/dpi-checker" data-pass-src>Try the art checker →</a></p>}
      {c.id === 'embed' && <p style="margin-top:14px"><a href="/for-shops">Install guide →</a></p>}</div>
      <figure class="frame"><img src={c.src} width="1200" height="900" alt={c.alt} loading={i ? 'lazy' : 'eager'}></figure></article>
  ))}
  <div class="soon" id="deposits"><span class="badge">Coming soon</span><div><h3>Deposits</h3><p>Take a Stripe deposit as soon as the customer approves. This isn’t built yet.</p></div><a class="btn ghost" href="/pricing">See pricing →</a></div>
</section>
</Base>
