---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
const img = (n: string) => `/images/features/${n}.webp`;
const cards = [
  { id: 'leads', title: 'Lead generation', soon: false, src: img('lead-gen-price-range'),
    alt: 'OKtoPress embed step 3 showing a rough estimate price range of $615 to $755 CAD for 48 tees, with an example-prices note',
    copy: 'Turn art checks into people you can follow up with. The customer enters contact details to see an instant price range.',
    bullets: ['Instant price range for the customer', 'An email alert for each new lead', 'All leads in one Leads list', 'CSV export'] },
  { id: 'quotes', title: 'Quote generation', soon: false, src: img('quote-editor'),
    alt: 'OKtoPress quote editor with line items, quantity and unit price, setup fees, tax and turnaround date',
    copy: 'Price jobs your way, without retyping. Set your own questions and price rules, then turn a lead into a quote in one click.',
    bullets: ['Your own questions for customers', 'Colours × quantity grid, screen fees, minimums', 'Lead to quote in one click', 'Revise and email the customer a link'] },
  { id: 'approvals', title: 'Approvals', soon: false, src: img('approvals-typed-name-record'),
    alt: 'Customer quote page with the name typed and the approval box ticked, above the shop’s approval record with timestamp and SHA-256 fingerprints',
    copy: 'Get clear sign-off before you burn screens. The customer approves the proof and quote by typing their name.',
    bullets: ['Approve by typing a name', 'Timestamped, tamper-evident record', 'SHA-256 fingerprint of quote and proof', 'Helps with proof disputes and chargebacks'] },
  { id: 'deposits', title: 'Deposits', soon: true, src: img('deposits-placeholder'),
    alt: 'Illustrative placeholder labelled “Illustration only · Coming soon” showing a deposit card with a disabled pay button',
    copy: 'Take a Stripe deposit as soon as the customer approves. This isn’t built yet.',
    bullets: ['Stripe deposit after approval', 'Coming soon: not available today'] },
];
---
<Base title="Features: art checks, leads, quotes, approvals and deposits" description="OKtoPress features for small print shops: art checker, lead generation, quote generation, signed approvals and Stripe deposits (coming soon).">
<div class="wrap">
  <div class="page-hero"><h1>Features</h1><p>OKtoPress owns the pre-job step for small screen print, embroidery, DTF and sign shops: art upload, quote, signed proof and deposit. It sits alongside your existing shop software.</p>
  <div class="ctas"><a class="btn" href={SITE.signup}>Start free</a><a class="btn alt" href="/dpi-checker">Try the art checker</a></div></div>
</div>
<div class="band"><div class="wrap">
  <div class="fgrid">
    <article class="fcard wide" id="art-checker">
      <img src={img('art-checker-report')} width="1200" height="900" alt="OKtoPress art check report for a low-resolution JPG: estimate notice, 33 DPI low-resolution warning at 12 inches wide, and a 2-colour ink estimate" loading="eager" />
      <div class="fbody">
        <h2>Art checker</h2>
        <p>Catch bad files before they reach your inbox. The customer gets a plain-language report they can read and share.</p>
        <ul><li>Effective DPI at the size they want to print</li><li>Ink colour count (exact for vector, estimated for PNG and JPG)</li><li>Low-resolution warnings before the order goes in</li><li>A shareable, plain-language report</li></ul>
        <p><a href="/dpi-checker">Try the art checker</a></p>
      </div>
    </article>
    {cards.map((c) => (
      <article class="fcard" id={c.id}>
        <img src={c.src} width="1200" height="900" alt={c.alt} loading="lazy" />
        <div class="fbody">
          <h2>{c.title} {c.soon && <span class="soon">Coming soon</span>}</h2>
          <p>{c.copy}</p>
          <ul>{c.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      </article>
    ))}
  </div>
</div></div>
<div class="wrap">
  <section class="fband" id="embed">
    <img src={img('embed-style-look-and-feel')} width="1200" height="900" alt="OKtoPress Look & feel settings: suggest colours from your site, button, text and background colours, font and corner style, with a live preview of the checker" loading="lazy" />
    <div>
      <h2>On your site, in your style</h2>
      <p>Embed OKtoPress on your own website with one line of code. Style it to match your site.</p>
      <ul><li>One line of embed code</li><li>WordPress plugin available, Wix planned</li><li>Your colours, font and corners</li></ul>
      <p><a href="/for-shops">Install guide</a> · <a href="/pricing">Pricing</a></p>
    </div>
  </section>
</div>
</Base>
