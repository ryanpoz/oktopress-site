---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
---
<Base title="Pricing" description="OKtoPress pricing for print shops: Free, Leads at $9.99/month and Pro at $29.99/month (USD). Every feature is unlocked during early access.">
<header class="phero w"><p class="k">Pricing</p><h1>Simple, flat pricing.</h1><p class="lede">One flat monthly price. No per-quote fees. Prices in USD.</p></header>
<section class="sec tight w">
  <p class="ea"><span class="d"></span>Free while in early access: every feature is unlocked during early access.</p>
  <div class="tiers">
    <div class="tier"><p class="k">Free</p><p class="price">$0</p><ul><li>Art checker</li><li>"Powered by OKtoPress" branding</li><li>Up to 5 leads a month</li></ul><a class="btn ghost" href={SITE.signup}>Start free</a></div>
    <div class="tier"><p class="k">Leads</p><p class="price">$9.99 <small>/month</small></p><ul><li>Everything in Free</li><li>Unlimited leads</li><li>Lead email alerts</li></ul><a class="btn ghost" href={SITE.signup}>Start free</a></div>
    <div class="tier"><p class="k">Pro</p><p class="price">$29.99 <small>/month</small></p><ul><li>Everything in Leads</li><li>Quotes</li><li>Approval records</li><li>No OKtoPress branding</li></ul><a class="btn" href={SITE.signup}>Start free</a></div>
  </div>
  <p class="prom">No training <i>·</i> A flat price <i>·</i> Export your data anytime</p>
  <p class="muted" style="margin-top:20px"><span class="badge">Coming soon</span> Deposits. See <a href="/features">all features</a>.</p>
</section>
</Base>
